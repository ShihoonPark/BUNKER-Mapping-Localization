Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/PointCloud2
      Name: Map cloud
      Alpha: 0.55
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map_cloud
      Size (Pixels): 2
      Size (m): 0.02
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 135; 135; 135
      Enabled: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Raw scan (velodyne frame)
      Alpha: 0.8
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /raw_scan
      Size (Pixels): 3
      Size (m): 0.025
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 40; 120; 255
      Enabled: false
    - Class: rviz_default_plugins/PointCloud2
      Name: Registered scan
      Alpha: 1.0
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /registered_scan
      Size (Pixels): 4
      Size (m): 0.035
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 20; 255; 70
      Enabled: true
    - Class: rviz_default_plugins/Path
      Name: GICP accepted path
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /gicp_path
      Color: 255; 255; 0
      Line Style: Lines
      Line Width: 0.03
      Enabled: true
    - Class: rviz_default_plugins/Pose
      Name: GICP pose
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /gicp_pose
      Color: 0; 255; 0
      Enabled: true
    - Class: rviz_default_plugins/Pose
      Name: Prediction pose
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /prediction_pose
      Color: 255; 0; 255
      Enabled: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Correspondences (max 200)
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /gicp_correspondences
      Enabled: false
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
  Global Options:
    Background Color: 24; 24; 24
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 14
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 1.35
      Yaw: 0.0
Window Geometry:
  Width: 1500
  Height: 900
